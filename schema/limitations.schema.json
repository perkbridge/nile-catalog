{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nile version limitations and tested matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "versions"],
  "properties": {
    "schema_version": { "const": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "limitations"],
        "properties": {
          "version": { "type": "string", "minLength": 1, "maxLength": 64 },
          "summary": { "type": "string", "maxLength": 300 },
          "tested": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operating_systems": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
                    "arch": { "type": "string", "maxLength": 32 },
                    "notes": { "type": "string", "maxLength": 300 }
                  }
                }
              },
              "runtime": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["component"],
                  "properties": {
                    "component": { "type": "string", "minLength": 1, "maxLength": 80 },
                    "version": { "type": "string", "maxLength": 64 },
                    "notes": { "type": "string", "maxLength": 300 }
                  }
                }
              },
              "connectors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["connector", "name"],
                  "properties": {
                    "connector": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
                    "tested_versions": {
                      "type": "array",
                      "items": { "type": "string", "maxLength": 64 }
                    },
                    "notes": { "type": "string", "maxLength": 300 }
                  }
                }
              }
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "description"],
              "properties": {
                "title": { "type": "string", "minLength": 1, "maxLength": 120 },
                "severity": { "enum": ["info", "warning", "critical"] },
                "connector": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "description": { "type": "string", "maxLength": 600 }
              }
            }
          }
        }
      }
    }
  }
}
